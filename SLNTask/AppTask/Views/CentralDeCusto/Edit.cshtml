@model AppTask.Models.CentralDeCusto

@{
    ViewData["Title"] = "Editar Central de Custo";
}

<div class="container py-4" style="background-color: #f9fafb; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 font-weight-bold mb-1" style="color: #111827; font-weight: 700;">Editar Central de Custo</h1>
                    <p class="text-muted small mb-0" style="color: #6b7280;">Atualize as informações do registro #@Model?.Codigo</p>
                </div>
                <a asp-action="Index" class="btn px-3 py-2 font-weight-bold text-decoration-none" style="background-color: #f5f6fa; color: #5a607f; border-radius: 8px; border: none;">
                    ← Voltar
                </a>
            </div>

            <div class="card border-0 shadow-sm p-3 p-md-4" style="border-radius: 16px; background-color: #ffffff; border: 1px solid #f1f5f9;">
                <div class="card-body p-2">

                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="Codigo" />

                        <div class="mb-3">
                            <label asp-for="NomeCentral" class="form-label font-weight-bold small mb-1" style="color: #374151;">
                                Nome da Central
                            </label>
                            <input asp-for="NomeCentral" class="form-control py-2 px-3" style="border-radius: 8px; border: 1px solid #e5e7eb; background-color: #f9fafb;" />
                            <span asp-validation-for="NomeCentral" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ValorMetaAnual" class="form-label font-weight-bold small mb-1" style="color: #374151;">
                                Valor Meta Anual
                            </label>
                            <input asp-for="ValorMetaAnual" class="form-control py-2 px-3" style="border-radius: 8px; border: 1px solid #e5e7eb; background-color: #f9fafb;" />
                            <span asp-validation-for="ValorMetaAnual" class="text-danger small"></span>
                        </div>

                        <hr style="border-top: 1px solid #f3f4f6; margin: 20px 0;" />

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-action="Index" class="btn px-4 py-2 me-2 font-weight-bold text-decoration-none" style="background-color: #f5f6fa; color: #5a607f; border-radius: 8px; border: none; font-size: 0.85rem;">
                                Cancelar
                            </a>
                            <button type="submit" class="btn text-white px-4 py-2 font-weight-bold shadow-sm" style="background-color: #5d2bee; border-radius: 8px; border: none; font-size: 0.85rem;">
                                Salvar Alterações
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}