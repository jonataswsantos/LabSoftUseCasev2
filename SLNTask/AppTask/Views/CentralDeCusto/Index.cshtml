@model IEnumerable<AppTask.Models.CentralDeCusto>

@{
    ViewData["Title"] = "Centrais de Custo";
    int totalItems = Model?.Count() ?? 0;
}

<div class="container-fluid py-4 px-4" style="background-color: #f9fafb; min-height: 100vh;">

    <!-- Cabeçalho com Contador e Botão Novo -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 font-weight-bold mb-1" style="color: #111827; font-weight: 700;">Centrais de Custo</h1>
            <p class="text-muted small mb-0" style="color: #6b7280;">@totalItems central(is) cadastrada(s)</p>
        </div>
        <a asp-action="Create" class="btn text-white px-4 py-2 font-weight-bold shadow-sm text-decoration-none" style="background-color: #5d2bee; border-radius: 10px; border: none;">
            + Nova Central
        </a>
    </div>

    <!-- Grid de Cartões -->
    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 16px; background-color: #ffffff; border: 1px solid #f1f5f9;">
                        <div class="card-body d-flex flex-column justify-content-between p-2">

                            <div>
                                <!-- Topo do Card: Ícone + Título + Badge -->
                                <div class="d-flex align-items-center mb-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background-color: #f0ebff; color: #5d2bee; font-size: 1.2rem; flex-shrink: 0;">
                                        🏢
                                    </div>
                                    <div>
                                        <h5 class="font-weight-bold mb-1" style="color: #111827; font-size: 1rem; font-weight: 700;">
                                            @item.NomeCentral
                                        </h5>
                                        <span class="badge px-3 py-1 font-weight-bold" style="background-color: #f1f3f9; color: #3b4256; border-radius: 12px; font-size: 0.75rem;">
                                            #@item.Codigo
                                        </span>
                                    </div>
                                </div>

                                <hr style="border-top: 1px solid #f3f4f6; margin: 12px 0;" />

                                <!-- Detalhes -->
                                <div class="mb-3" style="font-size: 0.85rem; color: #4b5563;">
                                    <div class="d-flex align-items-center mb-1">
                                        <span class="me-2">💰</span>
                                        <span>Meta Anual: <strong>@item.ValorMetaAnual</strong></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Botões de Ação na Base -->
                            <div class="row g-2 pt-2 mt-auto">
                                <div class="col-4">
                                    <a asp-action="Details" asp-route-id="@item.Codigo" class="btn w-100 py-2 font-weight-bold text-center text-decoration-none" style="background-color: #f5f6fa; color: #5a607f; border-radius: 8px; font-size: 0.85rem; border: none;">
                                        Abrir
                                    </a>
                                </div>
                                <div class="col-4">
                                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn w-100 py-2 font-weight-bold text-center text-decoration-none" style="background-color: #f0ebff; color: #6d2bee; border-radius: 8px; font-size: 0.85rem; border: none;">
                                        Editar
                                    </a>
                                </div>
                                <div class="col-4">
                                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn w-100 py-2 font-weight-bold text-center text-decoration-none" style="background-color: #fde8e8; color: #dc2626; border-radius: 8px; font-size: 0.85rem; border: none;">
                                        Excluir
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-4 text-center text-muted" style="border-radius: 16px; background-color: #ffffff;">
                    Nenhuma central de custo cadastrada.
                </div>
            </div>
        }
    </div>

</div>