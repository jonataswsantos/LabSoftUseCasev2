@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container py-5" style="background-color: #f9fafb; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <!-- Cartão Principal de Boas-vindas -->
            <div class="card border-0 shadow-sm p-4 text-center" style="border-radius: 16px; background-color: #ffffff; border: 1px solid #f1f5f9;">
                <div class="card-body py-4">

                    <!-- Ícone de Destaque -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px; background-color: #f0ebff; color: #5d2bee; font-size: 2rem;">
                        🚀
                    </div>

                    <!-- Título e Subtítulo -->
                    <h1 class="h3 font-weight-bold mb-2" style="color: #111827; font-weight: 700;">
                        Bem-vindo ao AppTask
                    </h1>
                    <p class="mb-4" style="color: #6b7280; font-size: 0.95rem;">
                        Gerencie suas tarefas e incidentes de forma simples, rápida e organizada.
                    </p>

                    <hr style="border-top: 1px solid #f3f4f6; margin: 24px 0;" />

                    <!-- Botões de Ação -->
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                        <a asp-controller="Incidentes" asp-action="Index" class="btn text-white px-4 py-2 me-sm-2 font-weight-bold shadow-sm text-decoration-none mb-2 mb-sm-0" style="background-color: #5d2bee; border-radius: 8px; border: none; font-size: 0.9rem;">
                            Ver Incidentes
                        </a>
                        <a href="https://learn.microsoft.com/aspnet/core" target="_blank" class="btn px-4 py-2 font-weight-bold text-decoration-none" style="background-color: #f5f6fa; color: #5a607f; border-radius: 8px; border: none; font-size: 0.9rem;">
                            Documentação ASP.NET
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
