<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AppTask</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppTask.styles.css" asp-append-version="true" />

    <style>
        body {
            background-color: #f9fafb;
            min-height: 100vh;
            margin: 0;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }

        .app-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Lateral */
        .sidebar {
            width: 250px;
            background-color: #1a173b;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            padding: 1.5rem 1rem;
        }

        .sidebar-brand {
            font-size: 1.25rem;
            font-weight: 700;
            color: #ffffff;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            margin-bottom: 2rem;
            padding-left: 0.5rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            color: #b0b3c7;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            border-radius: 12px;
            transition: all 0.2s ease-in-out;
        }

            .sidebar-link:hover {
                color: #ffffff;
                background-color: rgba(255, 255, 255, 0.08);
            }

            /* Destaque da página atual */
            .sidebar-link.active {
                background-color: #5d2bee;
                color: #ffffff;
                box-shadow: 0 4px 12px rgba(93, 43, 238, 0.3);
            }

        /* Area de Conteudo */
        .main-content {
            flex-grow: 1;
            background-color: #f9fafb;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .content-body {
            padding: 2rem;
            flex-grow: 1;
        }

        .footer-custom {
            padding: 1rem 2rem;
            color: #9ca3af;
            font-size: 0.85rem;
            background-color: #f9fafb;
        }
    </style>
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    }

    <div class="app-wrapper">
        <!-- Sidebar Lateral -->
        <aside class="sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span style="color: #5d2bee; font-size: 1.4rem;">📊</span> AppTask
            </a>

            <ul class="sidebar-nav">
                <li>
                    <a class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                       asp-area="" asp-controller="Home" asp-action="Index">
                        <span>🏠</span> Home
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "Tarefa" && currentAction == "Index" ? "active" : "")"
                       asp-area="" asp-controller="Tarefa" asp-action="Index">
                        <span>✅</span> Tarefas
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "Funcionarios" ? "active" : "")"
                       asp-area="" asp-controller="Funcionarios" asp-action="Index">
                        <span>👥</span> Funcionários
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "Incidentes" ? "active" : "")"
                       asp-area="" asp-controller="Incidentes" asp-action="Index">
                        <span>🚨</span> Incidentes
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "CentralDeCusto" ? "active" : "")"
                       asp-area="" asp-controller="CentralDeCusto" asp-action="Index">
                        <span>🏢</span> Central de Custo
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "Departamento" ? "active" : "")"
                       asp-area="" asp-controller="Departamento" asp-action="Index">
                        <span>📁</span> Departamentos
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "Tarefa" && currentAction == "Sobre" ? "active" : "")"
                       asp-area="" asp-controller="Tarefa" asp-action="Sobre">
                        <span>ℹ️</span> Sobre
                    </a>
                </li>
                <li>
                    <a class="sidebar-link @(currentController == "Home" && currentAction == "Privacy" ? "active" : "")"
                       asp-area="" asp-controller="Home" asp-action="Privacy">
                        <span>🔒</span> Privacy
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Área Principal -->
        <div class="main-content">
            <main role="main" class="content-body">
                @RenderBody()
            </main>

            <footer class="footer-custom">
                &copy; 2026 - AppTask - <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none" style="color: #5d2bee;">Privacy</a>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>