@model AppTask.Models.Tarefa

@{
    ViewData["Title"] = "Excluir Tarefa";
}

<div class="container py-4" style="background-color: #f8f9fa; min-height: 100vh;">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">

            <!-- Cabeçalho -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="h3 font-weight-bold mb-1" style="color: #1e1e2d; font-weight: 700;">Excluir Tarefa</h1>
                    <p class="text-muted small mb-0">Confirme os dados antes de remover o registro</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary px-3 py-2 font-weight-bold" style="border-radius: 8px;">
                    ← Voltar
                </a>
            </div>

            <!-- Cartão de Confirmação -->
            <div class="card border-0 shadow-sm p-3 p-md-4" style="border-radius: 16px; background-color: #ffffff;">
                <div class="card-body">

                    <!-- Alerta de Atenção -->
                    <div class="alert p-3 mb-4 d-flex align-items-center" style="background-color: #ffe4e6; color: #9f1239; border-radius: 12px; border: 1px solid #fecdd3;">
                        <span class="mr-2" style="font-size: 1.2rem;">⚠️</span>
                        <div>
                            <strong>Tem certeza que deseja excluir esta tarefa?</strong>
                            <div class="small">Esta ação é permanente e não poderá ser desfeita.</div>
                        </div>
                    </div>

                    <!-- Título e Status -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h4 font-weight-bold mb-0" style="color: #2d3748;">
                            @Html.DisplayFor(model => model.Descricao)
                        </h3>
                        @{
                            var statusText = Model?.StatusTarefa?.ToString()?.ToUpper() ?? "";
                            var bgStatus = "#f1f5f9";
                            var textStatus = "#475569";

                            if (statusText.Contains("ANDAMENTO"))
                            {
                                bgStatus = "#fef3c7";
                                textStatus = "#d97706";
                            }
                            else if (statusText.Contains("FINALIZADA"))
                            {
                                bgStatus = "#dcfce7";
                                textStatus = "#15803d";
                            }
                            else if (statusText.Contains("CANCELADA"))
                            {
                                bgStatus = "#fee2e2";
                                textStatus = "#b91c1c";
                            }
                        }
                        <span class="badge px-3 py-2 text-uppercase font-weight-bold" style="background-color: @bgStatus; color: @textStatus; border-radius: 20px; font-size: 0.85rem;">
                            @Html.DisplayFor(model => model.StatusTarefa)
                        </span>
                    </div>

                    <!-- Funcionário -->
                    <div class="mb-4">
                        <span class="badge px-3 py-2 font-weight-normal" style="background-color: #f3e8ff; color: #6b21a8; border-radius: 20px; font-size: 0.85rem;">
                            👤 @(Model?.Funcionario?.Nome ?? Model?.Funcionario?.Cargo ?? "Sem funcionário atribuído")
                        </span>
                    </div>

                    <hr class="my-4" style="border-top: 1px solid #edf2f7;" />

                    <!-- Informações de Datas e Prazos -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted small mb-1">🗓️ Data Planejada</div>
                                <div class="font-weight-bold" style="color: #2d3748;">
                                    @Html.DisplayFor(model => model.DataPlanejada)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <div class="p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted small mb-1">⌛ Prazo</div>
                                <div class="font-weight-bold" style="color: #2d3748;">
                                    @Html.DisplayFor(model => model.Prazo)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted small mb-1">▶️ Data Iniciada</div>
                                <div class="font-weight-bold" style="color: #2d3748;">
                                    @Html.DisplayFor(model => model.DataIniciada)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted small mb-1">✅ Data Finalizada</div>
                                <div class="font-weight-bold" style="color: #2d3748;">
                                    @Html.DisplayFor(model => model.DataFinalizada)
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 mb-3">
                            <div class="p-3 rounded" style="background-color: #f8fafc; border: 1px solid #e2e8f0;">
                                <div class="text-muted small mb-1">🚫 Data Cancelada</div>
                                <div class="font-weight-bold" style="color: #2d3748;">
                                    @Html.DisplayFor(model => model.DataCancelada)
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Form de Confirmação de Exclusão -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Codigo" />

                        <div class="d-flex justify-content-end gap-2 border-top pt-4 mt-3">
                            <a asp-action="Index" class="btn btn-light px-4 py-2 border-0 mr-2" style="background-color: #f1f5f9; border-radius: 8px; font-weight: 500;">
                                Cancelar
                            </a>
                            <button type="submit" class="btn text-white px-4 py-2 font-weight-bold shadow-sm" style="background-color: #e11d48; border-radius: 8px;">
                                Confirmar Exclusão
                            </button>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>